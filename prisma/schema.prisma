generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Article {
  id              Int      @id @default(autoincrement())
  title           String
  slug            String   @unique
  subtitle        String?
  excerpt         String
  content         String
  author          String?
  category        String?
  location        String?
  image           String?
  tags            String?
  readTime        String?
  seoTitle        String?
  metaDescription String?
  keywords        String?
  featured        Boolean  @default(false)
  trending        Boolean  @default(false)
  breaking        Boolean  @default(false)
  published       Boolean  @default(false)
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  status          String   @default("draft")
  correspondentId Int?
  correspondent   Correspondent? @relation(fields: [correspondentId], references: [id], onDelete: SetNull)
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
}

model User {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Podcast {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  description String
  category    String
  thumbnail   String?
  audioUrl    String?
  videoUrl    String?
  duration    String?
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Video {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  description String
  category    String
  thumbnail   String?
  videoUrl    String
  duration    String?
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LiveTV {
  id          Int      @id @default(autoincrement())
  platform    String   @default("YouTube Live")
  status      String   @default("OFFLINE")
  streamTitle String   @default("Africana Live TV")
  channelName String?
  streamUrl   String?
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NewsletterSubscriber {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  subscribedAt DateTime @default(now())
}

model LiveInterview {
  id            Int                  @id @default(autoincrement())
  title         String
  guestName     String
  guestEmail    String?
  guestLocation String?
  interviewDate DateTime?
  roomName      String               @unique
  inviteToken   String               @unique
  status        String               @default("WAITING")
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  guests        LiveInterviewGuest[]
}

model LiveInterviewGuest {
  id          Int      @id @default(autoincrement())
  interviewId Int
  name        String
  email       String?
  location    String?
  inviteToken String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  interview LiveInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
}

model Correspondent {
  id             Int      @id @default(autoincrement())
  name           String
  slug           String   @unique
  photo          String?
  country        String?
  city           String?
  bio            String?
  specialization String?
  email          String?
  website        String?
  socialLinks    String?
  published      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  articles       Article[]
}

model Donation {
  id                Int      @id @default(autoincrement())
  donorName         String
  donorEmail        String
  amount            Decimal  @db.Decimal(12, 2)
  currency          String   @default("NGN")
  paymentMethod     String   @default("bank_transfer")
  frequency         String   @default("one-time")
  transferReference String?
  stripePaymentId   String?
  status            String   @default("pending")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([donorEmail])
  @@index([status])
  @@index([createdAt])
}

model DonationSettings {
  id                Int      @id @default(1)

  bankName          String?
  accountName       String?
  accountNumber     String?
  bankEnabled       Boolean  @default(false)

  stripeEnabled     Boolean  @default(false)
  stripePaymentLink String?

  paypalEnabled     Boolean  @default(false)
  paypalPaymentLink String?

  gofundmeEnabled   Boolean  @default(false)
  gofundmeLink      String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model JitsiInterview {
  id        Int                 @id @default(autoincrement())
  title     String
  roomName  String              @unique
  status    String              @default("WAITING")
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  guests    JitsiInterviewGuest[]

  @@index([status])
  @@index([createdAt])
}

model JitsiInterviewGuest {
  id          Int           @id @default(autoincrement())
  interviewId Int
  name        String
  email       String?
  inviteToken String        @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  interview   JitsiInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
}

